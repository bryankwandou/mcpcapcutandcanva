# xAI key from https://console.x.ai — set in Vercel > Project > Settings > Environment Variables.
# Without it the station runs in demo mode (scripted replies).
XAI_API_KEY=

# Optional: model fallback chain, first = preferred. Unknown models (400/404) fall through to the next.
# XAI_MODELS=grok-4.5,grok-4,grok-3

# Optional: chat requests per IP per minute (default 20).
# RATE_LIMIT_PER_MIN=20
