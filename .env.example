# Canva Connect API (https://www.canva.dev/docs/connect/)
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_REFRESH_TOKEN=
# CapCut drafts folder (auto-detected if empty)
# Windows: %LOCALAPPDATA%\CapCut\User Data\Projects\com.lveditor.draft
# macOS:   ~/Movies/CapCut/User Data/Projects/com.lveditor.draft
CAPCUT_DRAFTS_DIR=
# Set to 1 to enable mouse/keyboard/screenshot tools (live drag & drop)
ENABLE_DESKTOP_CONTROL=0
